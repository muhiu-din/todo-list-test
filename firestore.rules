rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeamMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    function isTeamOwner(teamId) {
      return signedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    function validString(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && validString(request.resource.data.displayName, 1, 80)
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isSelf(uid);
    }

    match /teams/{teamId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validString(request.resource.data.name, 1, 80)
        && validString(request.resource.data.inviteCode, 6, 6);
      allow update: if isTeamOwner(teamId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isTeamOwner(teamId);

      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        allow create: if isTeamOwner(teamId)
          || (isSelf(memberId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'member'
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode)).data.teamId == teamId);
        allow update: if isTeamOwner(teamId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role;
        allow delete: if isTeamOwner(teamId) || isSelf(memberId);
      }

      match /lists/{listId} {
        allow read, create, update, delete: if isTeamMember(teamId);
        match /tasks/{taskId} {
          allow read, create, update, delete: if isTeamMember(teamId);
        }
      }
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && isTeamOwner(request.resource.data.teamId);
    }

    match /users/{uid}/lists/{listId} {
      allow read, create, update, delete: if isSelf(uid);
      match /tasks/{taskId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }
  }
}
